    <!-- Onboarding -->
    <string name="onboarding_title">We need to become your default phone app</string>
    <string name="onboarding_subtitle">This is the only way Android lets an app see who's calling before you answer, and speak a greeting to callers you haven't approved yet.</string>
    <string name="onboarding_reason_screen_title">Screen calls silently.</string>
    <string name="onboarding_reason_screen_body">We check the number against your rules before your phone ever rings.</string>
    <string name="onboarding_reason_autoresponder_title">Power the optional auto-responder.</string>
    <string name="onboarding_reason_autoresponder_body">Only used if you turn it on yourself in Settings.</string>
    <string name="onboarding_reason_revert_body">You can switch back to your phone's original dialer at any time in Android Settings.</string>
    <string name="onboarding_never_do_header">WHAT WE WILL NEVER DO</string>
    <string name="onboarding_never_do_record">Record any call unless you separately turn that on, per call type.</string>
    <string name="onboarding_never_do_send_data">Send your call data, contacts, or numbers off this device.</string>
    <string name="onboarding_never_do_ads">Show ads or share information with third parties.</string>
    <string name="onboarding_open_source">This app is open source — view the code</string>
    <string name="onboarding_requesting_indicator">Waiting for the system dialog…</string>
    <string name="onboarding_denied_title">Not set as your default phone app</string>
    <string name="onboarding_denied_body">Without this, call screening and the auto-responder can't run. You can turn it on later from Settings.</string>

    <!-- Permissions checklist -->
    <string name="permissions_title">What we ask for, and why</string>
    <string name="permissions_subtitle">Each permission below is used for one thing only. Nothing here is required — you can refuse any of them and the rest of the app still works.</string>
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_body">Show you who is calling, and what was blocked while you were away. Without it you get no incoming-call alert at all.</string>
    <string name="permissions_fullscreen_title">Full-screen calls</string>
    <string name="permissions_fullscreen_body">Show a ringing call over your lock screen, with Answer and Decline, instead of only a notification. Granted from system settings, not from a dialog.</string>
    <string name="permissions_contacts_title">Contacts</string>
    <string name="permissions_contacts_body">Let people already in your contacts ring through, and show their name instead of a bare number. Contacts are read on this device and never sent anywhere.</string>
    <string name="permissions_phone_title">Phone</string>
    <string name="permissions_phone_body">See an incoming number before your phone rings, so it can be checked against your rules, and call a number back from the call log.</string>
    <string name="permissions_microphone_title">Microphone (optional)</string>
    <string name="permissions_microphone_body">Only used if you turn on recording for the auto-responder, which ships off.</string>
    <string name="permissions_granted">Granted</string>
    <string name="permissions_allow">Allow</string>
    <string name="permissions_asked_later">Asked only if you turn recording on</string>
    <string name="permissions_change_later">Changed your mind either way? Every one of these can be turned on or off later from Settings.</string>
