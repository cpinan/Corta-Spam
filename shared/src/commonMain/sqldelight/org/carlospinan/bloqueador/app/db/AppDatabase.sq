-- M2 schema: blocked numbers, pattern rules, country rules, allowlist, call log.
-- Precedence: allowlist > manual block > pattern > country (evaluated in code, not SQL).

CREATE TABLE BlockedNumber (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    label TEXT,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(number)
);

CREATE TABLE AllowlistedNumber (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    label TEXT,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(number)
);

CREATE TABLE PatternRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    pattern TEXT NOT NULL,
    label TEXT,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER))
);

CREATE TABLE CountryRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    country_code TEXT NOT NULL,
    country_name TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(country_code)
);

CREATE TABLE CallLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    timestamp INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    action TEXT NOT NULL CHECK (action IN ('ALLOWED', 'BLOCKED')),
    rule_type TEXT CHECK (rule_type IN ('MANUAL', 'PATTERN', 'COUNTRY', 'CONTACTS', 'SPAM', 'ACTION', 'AUTO_RESPONDER', 'SCHEDULE', 'REVIEW', 'REPEATED_ALLOWED', NULL)),
    rule_id INTEGER,
    rule_detail TEXT
);

-- BlockedNumber queries
-- created_at defaults to whole seconds, so rows added within the same second tie on it.
-- id DESC breaks the tie in insertion order, which is what "most recent first" in
-- RuleRepository's KDoc promises; without it SQLite falls back to rowid ASC and the
-- list comes back oldest-first for anything added in the same second.
selectAllBlockedNumbers:
SELECT * FROM BlockedNumber ORDER BY created_at DESC, id DESC;

selectBlockedNumberByNumber:
SELECT * FROM BlockedNumber WHERE number = ?;

insertBlockedNumber:
INSERT OR IGNORE INTO BlockedNumber(number, label) VALUES (?, ?);

-- Import-only variant. Backup restore must reproduce the exported row verbatim, including
-- created_at (which drives list order) and enabled. The `*Full` inserts exist so the importer
-- never has to write a default row and then hunt for "the one I just inserted" -- that hunt
-- used to read the last element of a DESC-ordered SELECT, i.e. the *oldest* row, and silently
-- disabled an unrelated rule on every restore that contained a disabled one.
insertBlockedNumberFull:
INSERT OR IGNORE INTO BlockedNumber(number, label, created_at) VALUES (?, ?, ?);

deleteBlockedNumberById:
DELETE FROM BlockedNumber WHERE id = ?;

countBlockedNumbers:
SELECT count(*) AS count FROM BlockedNumber;

-- AllowlistedNumber queries
selectAllAllowlistedNumbers:
SELECT * FROM AllowlistedNumber ORDER BY created_at DESC, id DESC;

selectAllowlistedNumberByNumber:
SELECT * FROM AllowlistedNumber WHERE number = ?;

insertAllowlistedNumber:
INSERT OR IGNORE INTO AllowlistedNumber(number, label) VALUES (?, ?);

insertAllowlistedNumberFull:
INSERT OR IGNORE INTO AllowlistedNumber(number, label, created_at) VALUES (?, ?, ?);

deleteAllowlistedNumberById:
DELETE FROM AllowlistedNumber WHERE id = ?;

countAllowlistedNumbers:
SELECT count(*) AS count FROM AllowlistedNumber;

-- PatternRule queries
selectAllPatternRules:
SELECT * FROM PatternRule ORDER BY created_at DESC, id DESC;

insertPatternRule:
INSERT INTO PatternRule(pattern, label) VALUES (?, ?);

insertPatternRuleFull:
INSERT INTO PatternRule(pattern, label, enabled, created_at) VALUES (?, ?, ?, ?);

-- Only meaningful when read inside the same transaction as the INSERT that produced it.
-- The importer uses it to build a source-id -> new-id map so an action rule's pattern_id
-- scope survives a restore instead of pointing at whatever row happens to hold that id now.
lastInsertRowId:
SELECT last_insert_rowid() AS id;

togglePatternRule:
UPDATE PatternRule SET enabled = ? WHERE id = ?;

deletePatternRuleById:
DELETE FROM PatternRule WHERE id = ?;

-- CountryRule queries
selectAllCountryRules:
SELECT * FROM CountryRule ORDER BY country_name ASC;

insertCountryRule:
INSERT OR IGNORE INTO CountryRule(country_code, country_name) VALUES (?, ?);

insertCountryRuleFull:
INSERT OR IGNORE INTO CountryRule(country_code, country_name, enabled, created_at) VALUES (?, ?, ?, ?);

toggleCountryRule:
UPDATE CountryRule SET enabled = ? WHERE id = ?;

deleteCountryRuleById:
DELETE FROM CountryRule WHERE id = ?;

-- CallLogEntry queries
insertCallLogEntry:
INSERT INTO CallLogEntry(number, timestamp, action, rule_type, rule_id, rule_detail)
VALUES (?, ?, ?, ?, ?, ?);

selectRecentCallLogEntries:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC LIMIT ?;

selectAllCallLogEntries:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC;

-- Serves every "blocked calls in a window" query. Without it each one is a full table scan of
-- the call log, which grows unbounded (only the user's own "clear log" ever shrinks it), and the
-- Home screen runs three of them plus a seven-day chart on every visit.
CREATE INDEX idx_call_log_action_time ON CallLogEntry(action, timestamp DESC);

-- Window boundaries are computed by the caller (StatsWindows) rather than in SQL. SQLite's
-- strftime('%s','now','start of day') is midnight *UTC*, so "blocked today" used to reset at
-- 19:00 local time in New York; and its date modifiers can't express a DST-aware day length.
-- kotlinx-datetime can, and gets unit-tested on the way through. timestamp is Unix millis.
countBlockedCallsSince:
SELECT count(*) AS count FROM CallLogEntry
WHERE action = 'BLOCKED' AND timestamp >= ?;

-- Only the timestamps, only the blocked ones, only back to the oldest bucket the chart shows.
-- blockedByDay used to pull every column of every row ever logged into memory to count seven
-- days' worth.
selectBlockedTimestampsSince:
SELECT timestamp FROM CallLogEntry
WHERE action = 'BLOCKED' AND timestamp >= ?
ORDER BY timestamp DESC;

clearCallLog:
DELETE FROM CallLogEntry;

-- Total entries logged with no matching rule while defaultAction=ASK (RuleDecision.PendingReview).
-- Not time-windowed like the stats above: it's a durable "needs a look" tag on historical
-- entries, not a live inbox with a resolved/unresolved state.
countPendingReview:
SELECT count(*) AS count FROM CallLogEntry WHERE rule_type = 'REVIEW';

-- AppSettings (key-value store for app preferences)
CREATE TABLE AppSettings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectSetting:
SELECT value FROM AppSettings WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO AppSettings(key, value) VALUES (?, ?);

-- ActionRule (block after N attempts within T minutes)
CREATE TABLE ActionRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    label TEXT,
    attempts INTEGER NOT NULL DEFAULT 3,
    window_minutes INTEGER NOT NULL DEFAULT 5,
    pattern_id INTEGER REFERENCES PatternRule(id),
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER))
);

selectAllActionRules:
SELECT * FROM ActionRule ORDER BY created_at DESC, id DESC;

insertActionRule:
INSERT INTO ActionRule(label, attempts, window_minutes, pattern_id) VALUES (?, ?, ?, ?);

insertActionRuleFull:
INSERT INTO ActionRule(label, attempts, window_minutes, pattern_id, enabled, created_at)
VALUES (?, ?, ?, ?, ?, ?);

toggleActionRule:
UPDATE ActionRule SET enabled = ? WHERE id = ?;

deleteActionRuleById:
DELETE FROM ActionRule WHERE id = ?;

-- CallAttempt (individual timestamps for action-rule counting)
CREATE TABLE CallAttempt (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phone_number TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

CREATE INDEX idx_call_attempt_number_time
    ON CallAttempt(phone_number, timestamp DESC);

insertCallAttempt:
INSERT INTO CallAttempt(phone_number, timestamp) VALUES (?, ?);

countRecentAttempts:
SELECT count(*) AS count FROM CallAttempt
WHERE phone_number = ? AND timestamp >= ?;

deleteExpiredAttempts:
DELETE FROM CallAttempt WHERE timestamp < ?;

-- ScheduleRule (quiet hours): blocks everything except the allowlist while the current local
-- time falls within [start_minute, end_minute) of the day (0-1439 minutes since local midnight).
-- end_minute < start_minute means the window crosses midnight (e.g. 22:00-07:00).
CREATE TABLE ScheduleRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    label TEXT,
    start_minute INTEGER NOT NULL,
    end_minute INTEGER NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER))
);

selectAllScheduleRules:
SELECT * FROM ScheduleRule ORDER BY created_at DESC, id DESC;

insertScheduleRule:
INSERT INTO ScheduleRule(label, start_minute, end_minute) VALUES (?, ?, ?);

insertScheduleRuleFull:
INSERT INTO ScheduleRule(label, start_minute, end_minute, enabled, created_at) VALUES (?, ?, ?, ?, ?);

toggleScheduleRule:
UPDATE ScheduleRule SET enabled = ? WHERE id = ?;

deleteScheduleRuleById:
DELETE FROM ScheduleRule WHERE id = ?;
