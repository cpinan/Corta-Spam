-- M2 schema: blocked numbers, pattern rules, country rules, allowlist, call log.
-- Precedence: allowlist > manual block > pattern > country (evaluated in code, not SQL).

CREATE TABLE BlockedNumber (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    label TEXT,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(number)
);

CREATE TABLE AllowlistedNumber (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    label TEXT,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(number)
);

CREATE TABLE PatternRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    pattern TEXT NOT NULL,
    label TEXT,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER))
);

CREATE TABLE CountryRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    country_code TEXT NOT NULL,
    country_name TEXT NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    UNIQUE(country_code)
);

CREATE TABLE CallLogEntry (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    number TEXT NOT NULL,
    timestamp INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    action TEXT NOT NULL CHECK (action IN ('ALLOWED', 'BLOCKED')),
    rule_type TEXT CHECK (rule_type IN ('MANUAL', 'PATTERN', 'COUNTRY', 'CONTACTS', 'SPAM', 'ACTION', 'AUTO_RESPONDER', NULL)),
    rule_id INTEGER,
    rule_detail TEXT
);

-- BlockedNumber queries
selectAllBlockedNumbers:
SELECT * FROM BlockedNumber ORDER BY created_at DESC;

selectBlockedNumberByNumber:
SELECT * FROM BlockedNumber WHERE number = ?;

insertBlockedNumber:
INSERT OR IGNORE INTO BlockedNumber(number, label) VALUES (?, ?);

deleteBlockedNumberById:
DELETE FROM BlockedNumber WHERE id = ?;

countBlockedNumbers:
SELECT count(*) AS count FROM BlockedNumber;

-- AllowlistedNumber queries
selectAllAllowlistedNumbers:
SELECT * FROM AllowlistedNumber ORDER BY created_at DESC;

selectAllowlistedNumberByNumber:
SELECT * FROM AllowlistedNumber WHERE number = ?;

insertAllowlistedNumber:
INSERT OR IGNORE INTO AllowlistedNumber(number, label) VALUES (?, ?);

deleteAllowlistedNumberById:
DELETE FROM AllowlistedNumber WHERE id = ?;

countAllowlistedNumbers:
SELECT count(*) AS count FROM AllowlistedNumber;

-- PatternRule queries
selectAllPatternRules:
SELECT * FROM PatternRule ORDER BY created_at DESC;

insertPatternRule:
INSERT INTO PatternRule(pattern, label) VALUES (?, ?);

togglePatternRule:
UPDATE PatternRule SET enabled = ? WHERE id = ?;

deletePatternRuleById:
DELETE FROM PatternRule WHERE id = ?;

-- CountryRule queries
selectAllCountryRules:
SELECT * FROM CountryRule ORDER BY country_name ASC;

insertCountryRule:
INSERT OR IGNORE INTO CountryRule(country_code, country_name) VALUES (?, ?);

toggleCountryRule:
UPDATE CountryRule SET enabled = ? WHERE id = ?;

deleteCountryRuleById:
DELETE FROM CountryRule WHERE id = ?;

-- CallLogEntry queries
insertCallLogEntry:
INSERT INTO CallLogEntry(number, timestamp, action, rule_type, rule_id, rule_detail)
VALUES (?, ?, ?, ?, ?, ?);

selectRecentCallLogEntries:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC LIMIT ?;

selectAllCallLogEntries:
SELECT * FROM CallLogEntry ORDER BY timestamp DESC;

-- timestamp is stored in Unix millis (see insertCallLogEntry callers); strftime('%s', ...)
-- returns seconds, so boundaries below are scaled to millis to match. strftime is used instead
-- of the newer unixepoch() function because unixepoch() needs SQLite 3.38+ and isn't present in
-- the SQLite bundled with older Android versions (confirmed crash on an API 33 emulator) —
-- strftime has been available since SQLite 3.0 and accepts the same date modifiers.
countBlockedCallsToday:
SELECT count(*) AS count FROM CallLogEntry
WHERE action = 'BLOCKED' AND timestamp >= CAST(strftime('%s', 'now', 'start of day') AS INTEGER) * 1000;

countBlockedCallsThisWeek:
SELECT count(*) AS count FROM CallLogEntry
WHERE action = 'BLOCKED' AND timestamp >= CAST(strftime('%s', 'now', 'start of day', 'weekday 0', '-6 days') AS INTEGER) * 1000;

countBlockedCallsThisMonth:
SELECT count(*) AS count FROM CallLogEntry
WHERE action = 'BLOCKED' AND timestamp >= CAST(strftime('%s', 'now', 'start of month') AS INTEGER) * 1000;

clearCallLog:
DELETE FROM CallLogEntry;

-- AppSettings (key-value store for app preferences)
CREATE TABLE AppSettings (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectSetting:
SELECT value FROM AppSettings WHERE key = ?;

upsertSetting:
INSERT OR REPLACE INTO AppSettings(key, value) VALUES (?, ?);

-- ActionRule (block after N attempts within T minutes)
CREATE TABLE ActionRule (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    label TEXT,
    attempts INTEGER NOT NULL DEFAULT 3,
    window_minutes INTEGER NOT NULL DEFAULT 5,
    enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER))
);

selectAllActionRules:
SELECT * FROM ActionRule ORDER BY created_at DESC;

insertActionRule:
INSERT INTO ActionRule(label, attempts, window_minutes) VALUES (?, ?, ?);

toggleActionRule:
UPDATE ActionRule SET enabled = ? WHERE id = ?;

deleteActionRuleById:
DELETE FROM ActionRule WHERE id = ?;

-- CallAttempt (individual timestamps for action-rule counting)
CREATE TABLE CallAttempt (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    phone_number TEXT NOT NULL,
    timestamp INTEGER NOT NULL
);

CREATE INDEX idx_call_attempt_number_time
    ON CallAttempt(phone_number, timestamp DESC);

insertCallAttempt:
INSERT INTO CallAttempt(phone_number, timestamp) VALUES (?, ?);

countRecentAttempts:
SELECT count(*) AS count FROM CallAttempt
WHERE phone_number = ? AND timestamp >= ?;

deleteExpiredAttempts:
DELETE FROM CallAttempt WHERE timestamp < ?;
