<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Placing a call back from the call log / a blocked-call notification (ACTION_CALL).
         READ_PHONE_STATE is deliberately NOT declared: ROLE_DIALER eligibility comes from the
         ACTION_DIAL activities below (AOSP roles.xml required-components), not from the phone
         permission set, which the role *grants* rather than demands. Nothing in this app reads
         telephony state. Re-adding it needs a caller, not a comment. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Required to post the ringing-call notification (API 33+) and to have Telecom's
         default-dialer full-screen-intent launch actually reach the lock screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- IN_CALL_SERVICE_RINGING below makes this app responsible for ringing, which includes
         the vibration the platform dialer would otherwise have produced. See CallRinger. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Auto-responder call recording, off by default and gated behind a consent line in the
         user's own greeting. Records MediaRecorder.AudioSource.MIC only: the real call-audio
         sources need CAPTURE_AUDIO_OUTPUT, which is signature|privileged and not available to
         this or any other third-party app. See AutoResponderRecorder for why that makes
         recording best-effort rather than guaranteed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Declared explicitly rather than inherited from READ_PHONE_STATE. This app *is* the
         dialer: without telephony there are no calls to screen, so a device that lacks it has
         nothing to install this for. required="true" is the honest declaration even though it
         costs ChromeOS availability. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <!-- Declaring RECORD_AUDIO makes Play imply android.hardware.microphone as REQUIRED, which
         silently drops every device without one — 6 of them, reported as lost device support on
         the versionCode 2 upload. Auto-responder recording is optional and ships off, and
         AutoResponderRecorder.start() already returns false on a missing or busy microphone, so
         requiring the hardware would exclude devices the app works fine on. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CortaSpamApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.CortaSpam">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ACTION_DIAL is a hard requirement for RoleManager.ROLE_DIALER
                 eligibility (docs/SPEC.md §4). -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Minimal answer/decline/hang-up UI, launched by
             PassthroughInCallService. Telecom expects the default dialer to
             supply this itself once IN_CALL_SERVICE_UI is declared below. -->
        <activity
            android:name=".telecom.InCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:theme="@style/Theme.CortaSpam" />

        <!-- Mandatory in-call UI for the default dialer role. M1 scope: pure
             pass-through, no blocking logic. See docs/SPEC.md §1 correction:
             this is InCallService, not a self-managed ConnectionService;
             real SIM calls are still furnished by Android's built-in
             telephony ConnectionService. -->
        <service
            android:name=".telecom.PassthroughInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Answer/Decline actions from the full-screen ringing notification. -->
        <receiver
            android:name=".telecom.CallActionReceiver"
            android:exported="false" />

        <!-- Declared so Telecom stops posting its own missed-call notification beside this
             app's: MissedCallNotifierImpl delegates to the default dialer if — and only if —
             the dialer has a receiver for this action, and the test is the receiver existing,
             not what it does. Both action spellings are declared because AOSP has sent this
             under android.telecom.action and android.telephony.action at different times, and a
             filter that does not match buys nothing and fails silently.

             exported="true" is required for Telecom to see and reach it. It is guarded with
             READ_PHONE_STATE, which is also the permission Telecom sends the broadcast with —
             so no other app can spoof a missed call, and this app (which deliberately does not
             hold READ_PHONE_STATE) simply does not receive it. See the receiver's KDoc: the
             suppression is the point, and the notification the user sees comes from
             PassthroughInCallService handling the missed call itself. -->
        <receiver
            android:name=".telecom.MissedCallNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
                <action android:name="android.telephony.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
